<footer class="footer">

	{% if (_config.settings.footer.feed_icon) %}
		{% include '_social.twig' with {'social': _blog.social} %}
	{% endif %}

	{% include '_nav.twig' with {'navs': _blog.nav_footer} %}

	<span class="footer_item">&copy;
		{{ 'now' | date('Y') }}
	</span>

	{% if _branding %}
		<span class="footer_item branding">
			<a href="https://blogs.hyvor.com?source=branding" target="_blank">{{ 'made_with' | lang }}</a>
		</span>
	{% endif %}
</footer>
